#include <iostream>
using namespace std;

int main() {
    int anio;

    // Pedir el año 
    cout << "Ingresa un anio: ";
    cin >> anio;

    // Validar que el año sea positivo y mayor a cero
    if (anio > 0) {
        
        if ((anio % 4 == 0 && anio % 100 != 0) || (anio % 400 == 0)) {
            cout << "El anio " << anio << " es bisiesto.\n";
        } else {
            cout << "El anio " << anio << " no es bisiesto.\n";
        }
        
    } else {
        // Error si meten un numero negativo o cero
        cout << "Error: El anio debe ser un numero entero positivo.\n";
    }

    return 0;
}
